# Pre-commit gate — scoped to what the commit touches, so a one-line
# change is checked in seconds rather than a minute. Four parts:
#
#   1. lint-staged   per-file checks on the staged files only: eslint
#                    --fix + prettier for TS/TSX, prettier for JS/JSON,
#                    prettier + stylelint for CSS, markdownlint for
#                    Markdown, cspell for every prose-bearing kind,
#                    secretlint for everything, and the color-contrast
#                    guard whenever tokens.css is staged.
#   2. typecheck     full project (tsc -b). Types cross files, so this
#                    one stays whole-repo; it's fast on a warm build.
#   3. repo-scoped   the three node scripts whose findings aren't
#      scripts       per-file — component shapes, spec wikilinks, the
#                    voice guard. Each finishes in well under a second.
#   4. vitest related  the tests that touch the staged files.
#
# The repo-wide sweep this hook used to run (`pnpm lint`: eslint over
# all of src, stylelint over all CSS, markdownlint and cspell over
# every file, secretlint over the tree) moved to the pre-push gate
# (`pnpm run doctor`) and CI, where it runs once per push rather than
# once per commit. Nothing is checked less; it is checked at the right
# grain. When CI's `check` job grows a per-file step, add it to
# lint-staged; when it grows a repo-wide one, add it to doctor.

pnpm exec lint-staged
pnpm exec tsc -b
node ./scripts/check-component-shapes.mjs
node ./scripts/check-spec-wikilinks.mjs
node ./scripts/check-voice-and-copy.mjs

staged_ts=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx)$' || true)
if [ -n "$staged_ts" ]; then
  pnpm exec vitest related --run $staged_ts
fi
